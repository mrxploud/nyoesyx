{
  "name": "nyoesyx-lang",
  "displayName": "NYoesyx — AI-Native Language",
  "description": "Syntax highlighting, snippets, validation and execution for the NYoesyx Dense Token Protocol (.nesx) language.",
  "version": "1.0.0",
  "publisher": "nyoesyx-ai-swarm",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Snippets", "Linters"],
  "icon": "icon.png",
  "contributes": {
    "languages": [
      {
        "id": "nyoesyx",
        "aliases": ["NYoesyx", "nyoesyx", "DTP"],
        "extensions": [".nesx"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nyoesyx",
        "scopeName": "source.nyoesyx",
        "path": "./syntaxes/nyoesyx.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nyoesyx",
        "path": "./snippets/nyoesyx.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:nyoesyx"
  ],
  "main": "./out/extension.js"
}
